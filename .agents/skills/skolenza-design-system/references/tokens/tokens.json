{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "skolenza-design-system",
  "version": "1.0.0",
  "description": "Skolenza Design System tokens. color.primary.* shown here is the default institution ramp (#4287f5); it is regenerated at runtime from the institution brand hex via palette() in src/app/app.ts.",
  "color": {
    "primary": {
      "50":  { "value": "#f6f9fe", "type": "color", "comment": "tint 95% of brand" },
      "100": { "value": "#d2e2fd", "type": "color" },
      "200": { "value": "#aecbfb", "type": "color" },
      "300": { "value": "#8ab5f9", "type": "color" },
      "400": { "value": "#669ef7", "type": "color", "comment": "primary.color — dark theme" },
      "500": { "value": "#4287f5", "type": "color", "comment": "institution brand hex — primary.color, light theme" },
      "600": { "value": "#3873d0", "type": "color" },
      "700": { "value": "#2e5eac", "type": "color" },
      "800": { "value": "#244a87", "type": "color" },
      "900": { "value": "#1a3662", "type": "color" },
      "950": { "value": "#10223d", "type": "color" }
    },
    "neutral": {
      "comment": "Light theme is zinc. Under .dark, src/styles.css remaps --color-zinc-* to slate, so dark-mode zinc-* classes render neutral-dark.",
      "50":  { "value": "#fafafa", "type": "color" },
      "100": { "value": "#f4f4f5", "type": "color" },
      "200": { "value": "#e4e4e7", "type": "color" },
      "300": { "value": "#d4d4d8", "type": "color" },
      "400": { "value": "#a1a1aa", "type": "color" },
      "500": { "value": "#71717a", "type": "color" },
      "600": { "value": "#52525b", "type": "color" },
      "700": { "value": "#3f3f46", "type": "color" },
      "800": { "value": "#27272a", "type": "color" },
      "900": { "value": "#18181b", "type": "color" },
      "950": { "value": "#09090b", "type": "color" }
    },
    "neutral-dark": {
      "comment": "Slate ramp that .dark substitutes for zinc-* (Tailwind v4 slate, hex approximations of the oklch values).",
      "50":  { "value": "#f8fafc", "type": "color" },
      "100": { "value": "#f1f5f9", "type": "color" },
      "200": { "value": "#e2e8f0", "type": "color" },
      "300": { "value": "#cbd5e1", "type": "color" },
      "400": { "value": "#94a3b8", "type": "color" },
      "500": { "value": "#64748b", "type": "color" },
      "600": { "value": "#475569", "type": "color" },
      "700": { "value": "#334155", "type": "color" },
      "800": { "value": "#1e293b", "type": "color" },
      "900": { "value": "#0f172a", "type": "color" },
      "950": { "value": "#020617", "type": "color" }
    },
    "semantic": {
      "success": {
        "50":  { "value": "#f0fdf4", "type": "color" },
        "400": { "value": "#4ade80", "type": "color", "comment": "text — dark theme, 10.25:1 on slate-900" },
        "500": { "value": "#22c55e", "type": "color", "comment": "fill only — 2.28:1 on white" },
        "600": { "value": "#16a34a", "type": "color", "comment": "UI boundary on white — 3.30:1" },
        "700": { "value": "#15803d", "type": "color", "comment": "text — light theme, 5.02:1 on white" }
      },
      "warning": {
        "50":  { "value": "#fffbeb", "type": "color" },
        "400": { "value": "#fbbf24", "type": "color", "comment": "text — dark theme, 10.69:1 on slate-900" },
        "500": { "value": "#f59e0b", "type": "color", "comment": "fill only — 2.15:1 on white" },
        "600": { "value": "#d97706", "type": "color", "comment": "UI boundary on white — 3.19:1" },
        "700": { "value": "#b45309", "type": "color", "comment": "text — light theme, 5.02:1 on white" }
      },
      "error": {
        "50":  { "value": "#fef2f2", "type": "color" },
        "300": { "value": "#fca5a5", "type": "color", "comment": "invalid border — dark" },
        "400": { "value": "#f87171", "type": "color", "comment": "invalid border — light; text — dark, 6.45:1 on slate-900" },
        "500": { "value": "#ef4444", "type": "color", "comment": "3.76:1 on white — large text / icons only" },
        "600": { "value": "#dc2626", "type": "color", "comment": "text — light theme, 4.83:1 on white" }
      },
      "info": {
        "50":  { "value": "#eff6ff", "type": "color" },
        "400": { "value": "#60a5fa", "type": "color", "comment": "text — dark theme, 7.02:1 on slate-900" },
        "500": { "value": "#3b82f6", "type": "color", "comment": "3.68:1 on white — non-text only" },
        "600": { "value": "#2563eb", "type": "color", "comment": "text — light theme, 5.17:1 on white" }
      }
    },
    "surface": {
      "ground":  { "light": "#fafafa", "dark": "#020617", "type": "color" },
      "default": { "light": "#ffffff", "dark": "#0f172a", "type": "color" },
      "raised":  { "light": "#ffffff", "dark": "#1e293b", "type": "color" }
    },
    "text": {
      "primary": { "light": "#18181b", "dark": "#f8fafc", "type": "color" },
      "body":    { "light": "#3f3f46", "dark": "#f1f5f9", "type": "color" },
      "muted":   { "light": "#71717a", "dark": "#94a3b8", "type": "color" }
    },
    "border": {
      "default": { "light": "#e4e4e7", "dark": "#1e293b", "type": "color" },
      "strong":  { "light": "#d4d4d8", "dark": "#475569", "type": "color" }
    },
    "mask": {
      "background": { "light": "rgba(0,0,0,0.4)", "dark": "rgba(0,0,0,0.6)", "type": "color" }
    },
    "accent": {
      "progress": { "value": "#ca1922", "type": "color", "comment": "--ng-progress-color, route progress bar" },
      "avatar": [
        "#5D4037", "#00796B", "#1976D2", "#388E3C",
        "#F9A825", "#C2185B", "#7B1FA2", "#0288D1",
        "#F57C00", "#1ABC9C", "#1565C0", "#2E7D32",
        "#E65100", "#303F9F", "#6A1B9A", "#455A64"
      ]
    }
  },
  "spacing": {
    "base":  { "value": "0.25rem",  "type": "dimension", "comment": "3.25px at 13px root" },
    "0":     { "value": "0",        "type": "dimension" },
    "1":     { "value": "0.25rem",  "type": "dimension" },
    "1-5":   { "value": "0.375rem", "type": "dimension" },
    "2":     { "value": "0.5rem",   "type": "dimension" },
    "2-5":   { "value": "0.625rem", "type": "dimension" },
    "3":     { "value": "0.75rem",  "type": "dimension" },
    "4":     { "value": "1rem",     "type": "dimension" },
    "5":     { "value": "1.25rem",  "type": "dimension" },
    "6":     { "value": "1.5rem",   "type": "dimension" },
    "8":     { "value": "2rem",     "type": "dimension" },
    "10":    { "value": "2.5rem",   "type": "dimension" },
    "12":    { "value": "3rem",     "type": "dimension" },
    "16":    { "value": "4rem",     "type": "dimension" },
    "layout": {
      "header-height":           { "value": "55px",   "type": "dimension", "comment": "h-[55px] in the header; list pages still subtract 4.6rem (see content-height)" },
      "sidebar-width":           { "value": "20rem",  "type": "dimension" },
      "sidebar-width-collapsed": { "value": "65px",   "type": "dimension" },
      "content-height":          { "value": "calc(100vh - 4.6rem)", "type": "dimension" },
      "page-gutter-xs":          { "value": "0.75rem", "type": "dimension" },
      "page-gutter-sm":          { "value": "1rem",    "type": "dimension" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "value": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "type": "fontFamily" },
      "mono": { "value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace", "type": "fontFamily" }
    },
    "rootFontSize": { "value": "0.8125rem", "type": "dimension", "comment": "13px — all rem values in styles scale by 0.8125; media-query rem does not" },
    "fontSize": {
      "xs":   { "value": "0.75rem",  "px": 9.75 },
      "sm":   { "value": "0.875rem", "px": 11.38 },
      "base": { "value": "1rem",     "px": 13 },
      "lg":   { "value": "1.125rem", "px": 14.63 },
      "xl":   { "value": "1.25rem",  "px": 16.25 },
      "2xl":  { "value": "1.5rem",   "px": 19.5 },
      "3xl":  { "value": "1.875rem", "px": 24.38 },
      "4xl":  { "value": "2.25rem",  "px": 29.25 },
      "5xl":  { "value": "3rem",     "px": 39 }
    },
    "fontWeight": {
      "regular":  { "value": 400 },
      "medium":   { "value": 500 },
      "semibold": { "value": 600 },
      "bold":     { "value": 700 }
    },
    "lineHeight": {
      "tight":   { "value": 1.2 },
      "snug":    { "value": 1.35 },
      "normal":  { "value": 1.5 },
      "relaxed": { "value": 1.65 }
    },
    "letterSpacing": {
      "tight":  { "value": "-0.02em" },
      "normal": { "value": "0" },
      "wide":   { "value": "0.06em" }
    },
    "style": {
      "display-lg": { "fontSize": "5xl",  "fontWeight": "bold",     "lineHeight": 1.1,  "letterSpacing": "-0.02em" },
      "display-md": { "fontSize": "4xl",  "fontWeight": "bold",     "lineHeight": 1.15, "letterSpacing": "-0.02em" },
      "display-sm": { "fontSize": "3xl",  "fontWeight": "medium",   "lineHeight": 1.2,  "letterSpacing": "-0.01em" },
      "h1":         { "fontSize": "2xl",  "fontWeight": "semibold", "lineHeight": 1.25, "letterSpacing": "-0.015em" },
      "h2":         { "fontSize": "xl",   "fontWeight": "semibold", "lineHeight": 1.3,  "letterSpacing": "-0.01em" },
      "h3":         { "fontSize": "lg",   "fontWeight": "semibold", "lineHeight": 1.35, "letterSpacing": "-0.005em" },
      "h4":         { "fontSize": "base", "fontWeight": "semibold", "lineHeight": 1.4,  "letterSpacing": "0" },
      "h5":         { "fontSize": "sm",   "fontWeight": "semibold", "lineHeight": 1.45, "letterSpacing": "0.005em" },
      "h6":         { "fontSize": "xs",   "fontWeight": "semibold", "lineHeight": 1.5,  "letterSpacing": "0.06em", "textTransform": "uppercase" },
      "body-lg":    { "fontSize": "base", "fontWeight": "regular",  "lineHeight": 1.6,  "letterSpacing": "0" },
      "body-md":    { "fontSize": "sm",   "fontWeight": "regular",  "lineHeight": 1.55, "letterSpacing": "0" },
      "body-sm":    { "fontSize": "xs",   "fontWeight": "regular",  "lineHeight": 1.5,  "letterSpacing": "0.005em" },
      "caption":    { "fontSize": "sm",   "fontWeight": "regular",  "lineHeight": 1.45, "letterSpacing": "0.005em", "color": "text.muted" },
      "label":      { "fontSize": "sm",   "fontWeight": "medium",   "lineHeight": 1.4,  "letterSpacing": "0" },
      "label-sm":   { "fontSize": "xs",   "fontWeight": "medium",   "lineHeight": 1.4,  "letterSpacing": "0.01em" },
      "code":       { "fontFamily": "mono", "fontSize": "sm", "fontWeight": "regular", "lineHeight": 1.5 }
    }
  },
  "border": {
    "width": { "none": "0", "hairline": "1px", "thick": "2px" },
    "style": { "solid": "solid", "dashed": "dashed" },
    "radius": {
      "none": "0",
      "xs":   "2px",
      "sm":   "4px",
      "md":   "6px",
      "lg":   "8px",
      "xl":   "12px",
      "card": "0.8rem",
      "full": "9999px"
    },
    "focusRing": {
      "width":  "2px",
      "style":  "solid",
      "color":  { "light": "{color.primary.500}", "dark": "{color.primary.400}" },
      "offset": "2px",
      "comment": "Code currently declares 1px — see open-items DS-04 / A11Y-08"
    },
    "anchorGutter": "2px"
  },
  "shadow": {
    "none":  "none",
    "xs":    "0 0 #0000, 0 0 #0000, 0 1px 2px 0 rgba(18,18,23,0.05)",
    "sm":    "0 1px 3px 0 rgba(0,0,0,0.1), 0 1px 2px -1px rgba(0,0,0,0.1)",
    "md":    "0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -2px rgba(0,0,0,0.1)",
    "lg":    "0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -4px rgba(0,0,0,0.1)",
    "xl":    "0 20px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1)",
    "focus": "0 0 0 2px var(--p-primary-color)",
    "comment": "Dark theme uses none; elevation is carried by borders and surface steps."
  },
  "animation": {
    "duration": {
      "instant":    "0ms",
      "fast":       "150ms",
      "base":       "200ms",
      "moderate":   "300ms",
      "slow":       "500ms",
      "deliberate": "700ms"
    },
    "easing": {
      "standard":   "cubic-bezier(0.4, 0, 0.2, 1)",
      "decelerate": "cubic-bezier(0, 0, 0.2, 1)",
      "accelerate": "cubic-bezier(0.4, 0, 1, 1)",
      "emphasized": "cubic-bezier(0.2, 0, 0, 1)",
      "linear":     "linear"
    },
    "disabledOpacity": "0.6"
  },
  "zIndex": {
    "base": 0,
    "raised": 1,
    "sticky": 10,
    "scrim": 14,
    "drawer": 15,
    "overlay": 1000,
    "modal": 1100,
    "tooltip": 1100,
    "progress": 50,
    "comment": "overlay / modal / tooltip are Optimus defaults (menu 1000). Route progress bar is z-50! in src/app/app.html."
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px",
    "comment": "Media-query rem resolves against 16px, not the 13px root — these px values are exact. lg (1024px) is the layout pivot."
  }
}
