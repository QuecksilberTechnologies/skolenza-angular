{
  "permissions": {
    "allow": [
      "Bash(ng test:*)",
      "Bash(ng lint:*)",
      "Bash(ng build:*)",
      "Bash(bun run test:*)",
      "Bash(bunx oxfmt --check:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(bun publish:*)",
      "Bash(bunx:*)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(cat .env:*)",
      "Read(.env*)",
      "Edit(.env*)",
      "Edit(node_modules/**)",
      "Edit(.git/**)"
    ]
  },
  "enabledMcpjsonServers": ["angular-cli"],
  "skillOverrides": {},
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'IMPORTANT: Before responding, review skills (run /skills if unsure) and activate those relevant to this request.'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | grep -E '\\.(ts|html)$' | xargs -r bunx eslint --quiet --no-error-on-unmatched-pattern 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {}
}
