{
  "name": "skolenza",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "lint": "ng lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "clean": "node -e \"for (const d of ['node_modules', '.angular', 'dist']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "analyze": "ng build --configuration production --source-map && node scripts/analyze.mjs"
  },
  "dependencies": {
    "@angular/aria": "^22.2.0",
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@fullcalendar/angular": "^7.1.0",
    "@ngrx/signals": "^22.0.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@openng/icons": "^1.0.0",
    "@openng/optimus-ui": "^2.0.2",
    "@openng/optimus-ui-tailwindcss": "^2.0.2",
    "@openng/optimus-ui-themes": "^2.0.2",
    "@sentry/angular": "^11.0.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "angularx-qrcode": "^22.0.1",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "fullcalendar": "^7.1.0",
    "html2canvas-pro": "^2.4.5",
    "jspdf": "^4.2.1",
    "lucide-angular": "^1.0.0",
    "payments-icons-library": "^1.1.12",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/language-server": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-eslint": "22.5.0",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.70.0",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@typescript-eslint/types": "8.70.1",
    "@typescript-eslint/utils": "8.70.1"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --cache --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{html,scss,css}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "bun@1.3.11",
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
